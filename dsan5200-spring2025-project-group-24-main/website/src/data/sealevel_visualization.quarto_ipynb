    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "import pandas as pd\n",
        "import altair as alt\n",
        "\n",
        "# import the data\n",
        "bangladesh = pd.read_excel(\"bangladesh_sea_level.xlsx\", sheet_name=\"Observations\")\n",
        "maldives = pd.read_excel(\"maldives_sea_level.xlsx\", sheet_name=\"Observations\")\n",
        "philippines = pd.read_excel(\"philippines_sea_level.xlsx\", sheet_name=\"Observations\")\n",
        "all_countries = pd.read_excel(\"sealevel_global_explorer_data_global.xlsx\", sheet_name=\"Observations\")\n",
        "\n",
        "# add country column to data\n",
        "bangladesh['Country'] = 'Bangladesh'\n",
        "maldives['Country'] = 'Maldives'\n",
        "philippines['Country'] = 'Philippines'\n",
        "all_countries['Country'] = 'Global'\n",
        "\n",
        "# create a list to hold data from all three countries\n",
        "data = []\n",
        "\n",
        "\n",
        "for df in [bangladesh, maldives, philippines, all_countries]:\n",
        "    recon_df = df[['Reconstruction Year', 'Reconstruction Obs', 'Country']].copy()\n",
        "    recon_df.rename(columns={'Reconstruction Year': 'Year', 'Reconstruction Obs': 'Sea Level (mm)'}, inplace=True)\n",
        "    recon_df['Metric'] = 'Reconstruction Obs'\n",
        "    data.append(recon_df)\n",
        "\n",
        "    sat_df = df[['Satellite Altimetry Year', 'Satellite Altimetry', 'Country']].copy()\n",
        "    sat_df.rename(columns={'Satellite Altimetry Year': 'Year', 'Satellite Altimetry': 'Sea Level (mm)'}, inplace=True)\n",
        "    sat_df['Metric'] = 'Satellite Altimetry'\n",
        "    data.append(sat_df)\n",
        "\n",
        "\n",
        "# combine the dfs into a single df\n",
        "combined_df = pd.concat(data, ignore_index=True)\n",
        "\n",
        "# drop years with missing data\n",
        "combined_df.dropna(subset=['Sea Level (mm)', 'Year'], inplace=True)\n",
        "\n",
        "countries = combined_df['Country'].unique()\n",
        "metrics = combined_df['Metric'].unique()\n",
        "\n",
        "# create selection points\n",
        "country_select = alt.selection_point(\n",
        "    name='Country', \n",
        "    fields=['Country'],\n",
        "    bind=alt.binding_radio(options=countries, name='Country: '),\n",
        "    value=countries[0]\n",
        ")\n",
        "\n",
        "metric_select = alt.selection_point(\n",
        "    name='Metric',\n",
        "    fields=['Metric'], \n",
        "    bind=alt.binding_radio(options=metrics, name='Sea Level Metric: '), \n",
        "    value=metrics[0] \n",
        ")\n",
        "\n",
        "\n",
        "base = alt.Chart(combined_df).encode(\n",
        "    x=alt.X('Year:Q', axis=alt.Axis(title='Year', format='d')),\n",
        "    y=alt.Y('Sea Level (mm):Q', axis=alt.Axis(title='Sea Level Change (mm)')),\n",
        "    tooltip=['Country', 'Metric', 'Year', alt.Tooltip('Sea Level (mm)', format='.2f')] \n",
        ")\n",
        "\n",
        "\n",
        "line = base.mark_line(point=True).encode(\n",
        ").properties(\n",
        "    title='Sea Level Change Over Time In Selected Countries'\n",
        ")\n",
        "\n",
        "chart = line.add_params(\n",
        "    country_select,\n",
        "    metric_select\n",
        ").transform_filter(\n",
        "    country_select\n",
        ").transform_filter(\n",
        "    metric_select\n",
        ").interactive()\n",
        "\n",
        "chart.save(\"sea_level_plot.html\")\n",
        "chart.display()"
      ],
      "id": "1efbfe75",
      "execution_count": null,
      "outputs": []
    }
